# Variables de entorno requeridas para el bot
# Copia este archivo como .env para desarrollo local
# En Railway, configura estas variables en Settings > Variables

# Número de Nequi que se enviará a los clientes
NEQUI_NUMBER=3053421833

# Precio del plan (solo informativo, se muestra en el mensaje)
PLAN_PRICE=9.900

# Nombre del plan
PLAN_NAME=Plan Pro

# Ruta donde se guardan los archivos de sesión de WhatsApp
# En Railway: usa un volumen montado en /data
SESSION_DATA_PATH=/data/.wwebjs_auth

# Ruta del log de pagos en JSON
PAYMENT_LOG_PATH=/data/payments.json

# Puerto del servidor web (Railway lo asigna automáticamente, no cambiar en producción)
PORT=3001

# Path al ejecutable de Chrome (Railway lo detecta automáticamente con el Dockerfile)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
